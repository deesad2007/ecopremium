---
// Сквозная модалка заказа. Открывается любой кнопкой с атрибутом data-order
// (опц. data-product="Название" data-price="390" data-id="002").
// Заявка уходит в /api/order, оплата картой — в /api/pay.
---
<div class="modal-backdrop" id="orderModal" role="dialog" aria-modal="true" aria-labelledby="orderTitle">
  <div class="modal">
    <div class="modal-head">
      <div class="lbl ey" style="color:var(--gold)">Заявка на заказ</div>
      <h3 id="orderTitle">Оформление заказа</h3>
      <button class="x" id="orderClose" aria-label="Закрыть">&times;</button>
    </div>
    <div class="modal-body">
      <div class="order-summary" id="orderSummary" hidden>
        <span id="orderSummaryName">Товар</span>
        <b id="orderSummaryPrice">—</b>
      </div>
      <form id="orderForm" novalidate>
        <input type="hidden" name="product" id="fProduct" />
        <input type="hidden" name="productId" id="fProductId" />
        <input type="hidden" name="price" id="fPrice" />
        <input type="hidden" name="page" id="fPage" />
        {/* honeypot против спама */}
        <input type="text" name="company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />

        <div class="field">
          <label for="fName">Ваше имя <span class="req">*</span></label>
          <input type="text" id="fName" name="name" required autocomplete="name" placeholder="Как к вам обращаться" />
        </div>
        <div class="field">
          <label for="fPhone">Телефон <span class="req">*</span></label>
          <input type="tel" id="fPhone" name="phone" required autocomplete="tel" placeholder="+7 ___ ___-__-__" />
        </div>
        <div class="field">
          <label for="fEmail">Email</label>
          <input type="email" id="fEmail" name="email" autocomplete="email" placeholder="для дубля заявки" />
        </div>
        <div class="field" id="volField" hidden>
          <label for="fVolume">Объём</label>
          <select id="fVolume" name="volume"></select>
        </div>
        <div class="field">
          <label for="fComposition">Состав заказа</label>
          <textarea id="fComposition" name="composition" placeholder="Что и сколько хотите заказать"></textarea>
        </div>
        <div class="field">
          <label for="fDelivery">Способ доставки</label>
          <select id="fDelivery" name="delivery">
            <option value="">— выберите —</option>
            <option>Доставка по Москве</option>
            <option>СДЭК / транспортная компания по России</option>
            <option>Ozon</option>
            <option>Почта России</option>
            <option>Самовывоз с маслодельни</option>
          </select>
        </div>
        <div class="field" id="cdekBox" hidden>
          <label for="fCity">Город доставки</label>
          <div class="promo-row">
            <input type="text" id="fCity" name="city" autocomplete="address-level2" placeholder="Город доставки" />
            <button type="button" id="calcBtn">Рассчитать</button>
          </div>
          <div class="pay-note" id="cdekNote" hidden></div>
          <div class="cdek-opts" id="cdekOpts" hidden></div>
          <div class="field" id="pvzField" hidden style="margin-top:10px">
            <label for="fPvz">Пункт выдачи</label>
            <select id="fPvz"></select>
          </div>
        </div>
        <div class="field">
          <label for="fPromo">Промокод</label>
          <div class="promo-row">
            <input type="text" id="fPromo" name="promo" placeholder="Если есть" />
            <button type="button" id="promoBtn">Активировать</button>
          </div>
          <div class="pay-note" id="promoNote" hidden></div>
        </div>
        <div class="field">
          <label for="fAddress">Адрес доставки</label>
          <input type="text" id="fAddress" name="address" autocomplete="street-address" placeholder="Город, улица, дом, квартира" />
        </div>
        <div class="field">
          <label for="fComment">Комментарий</label>
          <textarea id="fComment" name="comment" placeholder="Город, адрес, пожелания"></textarea>
        </div>

        <label class="consent">
          <input type="checkbox" id="fConsent" name="consent" required />
          <span>Я даю согласие на обработку персональных данных и принимаю условия
            <a href="/policy" target="_blank" rel="noopener">политики обработки данных</a> и
            <a href="/oferta" target="_blank" rel="noopener">публичной оферты</a>.</span>
        </label>
        <button type="button" class="btn btn-g" id="orderPay" style="width:100%" hidden>Оплатить картой</button>
        <button type="submit" class="btn btn-dark" id="orderSubmit" style="width:100%">Отправить заявку</button>
        <p class="pay-note" id="payNote" hidden>Оплата картой через Робокассу. Чек придёт на почту сразу после оплаты.</p>
        <p class="pay-note" id="askNote">Заявка ни к чему не обязывает: менеджер свяжется с вами,
          подтвердит состав заказа и пришлёт способ оплаты.</p>
        <div class="form-msg" id="orderMsg" role="status"></div>
      </form>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('orderModal');
  const form = document.getElementById('orderForm');
  const msg = document.getElementById('orderMsg');
  const submit = document.getElementById('orderSubmit');
  const summary = document.getElementById('orderSummary');
  const sumName = document.getElementById('orderSummaryName');
  const sumPrice = document.getElementById('orderSummaryPrice');

  const volField = document.getElementById('volField');
  const volSelect = document.getElementById('fVolume');
  const nbsp = (n) => Number(n).toLocaleString('ru-RU').replace(/ /g, ' ').replace(/ /g, ' ');

  // пересчёт цены в сводке при смене объёма
  function applyPrice(product, price, volume) {
    document.getElementById('fPrice').value = price || '';
    sumPrice.innerHTML = price ? nbsp(price) + ' ₽' : '';
    sumName.textContent = volume ? `${product} · ${volume}` : product;
    document.getElementById('fComposition').value = price
      ? `${product}${volume ? ' — ' + volume : ''} — ${nbsp(price)} ₽`
      : product;
  }

  function openModal(product, price, volume, variantsRaw, productId) {
    form.reset();
    msg.className = 'form-msg';
    document.getElementById('fProduct').value = product || '';
    document.getElementById('fProductId').value = productId || '';
    document.getElementById('fPage').value = location.pathname;
    refreshPayButton();

    let variants = [];
    try { variants = variantsRaw ? JSON.parse(variantsRaw) : []; } catch {}

    if (variants.length) {
      volSelect.innerHTML = variants
        .map((v) => `<option value="${v.volume}" data-price="${v.price}">${v.volume} — ${nbsp(v.price)} ₽</option>`)
        .join('');
      const start = variants.find((v) => v.volume === volume) || variants[0];
      volSelect.value = start.volume;
      volField.hidden = false;
      applyPrice(product, start.price, start.volume);
      volSelect.onchange = () => {
        const v = variants.find((x) => x.volume === volSelect.value);
        if (v) applyPrice(product, v.price, v.volume);
      };
    } else {
      volField.hidden = true;
      volSelect.onchange = null;
      applyPrice(product, price, volume);
    }

    summary.hidden = !product;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('fName').focus(), 50);
  }
  function closeModal() {
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-order]');
    if (trigger) {
      e.preventDefault();
      openModal(
        trigger.getAttribute('data-product'),
        trigger.getAttribute('data-price'),
        trigger.getAttribute('data-volume'),
        trigger.getAttribute('data-variants'),
        trigger.getAttribute('data-id')
      );
    }
    if (e.target.id === 'orderClose' || e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // доступ извне (например, из корзины) — форма и её поля не меняются,
  // просто ещё один способ вызвать тот же openModal
  window.__ecoOpenOrder = openModal;

  // выбор объёма на карточке каталога одним кликом -> пересчёт цены и данных кнопки
  document.addEventListener('click', (e) => {
    const volBtn = e.target.closest('.card-vol-btn');
    if (!volBtn) return;
    const card = volBtn.closest('.pc');
    card.querySelectorAll('.card-vol-btn').forEach((b) => b.classList.remove('active'));
    volBtn.classList.add('active');
    const price = Number(volBtn.dataset.price);
    card.querySelector('.js-card-price').innerHTML = nbsp(price) + ' ₽';
    const btn = card.querySelector('.js-add-cart');
    if (btn) { btn.dataset.price = String(price); btn.dataset.volume = volBtn.textContent.trim(); }
  });

  // Промокод — заглушка (реальная проверка появится при подключении Робокассы/CRM)
  document.getElementById('promoBtn')?.addEventListener('click', () => {
    const note = document.getElementById('promoNote');
    const val = document.getElementById('fPromo').value.trim();
    note.hidden = false;
    note.textContent = val
      ? 'Промокод сохранён в заявке — менеджер применит скидку при подтверждении.'
      : 'Введите промокод.';
  });

  // ── оплата картой ──
  // Что оплачивать: либо корзина целиком, либо один товар с открытой карточки.
  // На сервер уходят только id, объём и количество: цену там берут из каталога.
  const payBtn = document.getElementById('orderPay');
  const payNote = document.getElementById('payNote');
  const askNote = document.getElementById('askNote');

  function payableLines() {
    let cart = [];
    try { cart = JSON.parse(localStorage.getItem('ecopremium_cart') || '[]'); } catch {}
    if (cart.length) {
      return cart
        .filter((i) => i.id && Number(i.price) > 0)
        .map((i) => ({ id: i.id, volume: i.volume || '', qty: i.qty || 1 }));
    }
    const id = document.getElementById('fProductId').value;
    const price = Number(document.getElementById('fPrice').value);
    if (!id || !(price > 0)) return [];
    return [{ id, volume: volField.hidden ? '' : volSelect.value, qty: 1 }];
  }

  function refreshPayButton() {
    const can = payableLines().length > 0;
    payBtn.hidden = !can;
    payNote.hidden = !can;
    askNote.hidden = can;
    cdekBox.hidden = !can;
    if (!can) resetDelivery();
  }

  volSelect.addEventListener('change', refreshPayButton);

  // ── расчёт доставки СДЭК ──
  // Отправляем только город и состав корзины. Цену доставки сервер считает сам
  // и пересчитывает заново при создании счёта: из браузера цена не принимается.
  const cdekBox = document.getElementById('cdekBox');
  const cdekNote = document.getElementById('cdekNote');
  const cdekOpts = document.getElementById('cdekOpts');
  const calcBtn = document.getElementById('calcBtn');
  let chosenDelivery = null;

  function resetDelivery() {
    chosenDelivery = null;
    cdekOpts.hidden = true;
    cdekOpts.innerHTML = '';
    cdekNote.hidden = true;
    document.getElementById('pvzField').hidden = true;
  }

  calcBtn?.addEventListener('click', async () => {
    const city = document.getElementById('fCity').value.trim();
    const items = payableLines();
    resetDelivery();
    if (!city) { cdekNote.hidden = false; cdekNote.textContent = 'Укажите город.'; return; }
    if (!items.length) { cdekNote.hidden = false; cdekNote.textContent = 'Сначала добавьте товары в корзину.'; return; }

    calcBtn.disabled = true;
    const was = calcBtn.textContent;
    calcBtn.textContent = 'Считаем…';
    try {
      const res = await fetch('/api/delivery', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ city, items }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.options?.length) throw new Error(data.error || 'Не удалось рассчитать доставку');

      cdekOpts.hidden = false;
      cdekOpts.innerHTML = data.options.map((o, i) => `
        <label class="cdek-opt">
          <input type="radio" name="cdekKind" value="${o.kind}" ${i === 0 ? 'checked' : ''} />
          <span>${o.kind === 'pvz' ? 'Пункт выдачи СДЭК' : 'Курьером до двери'}
            <b>${nbsp(o.price)} ₽</b>
            <i>${o.daysMin}–${o.daysMax} дн.</i></span>
        </label>`).join('');
      chosenDelivery = { kind: data.options[0].kind, city };
      cdekOpts.addEventListener('change', (e) => {
        if (e.target.name !== 'cdekKind') return;
        chosenDelivery = { kind: e.target.value, city };
        togglePvz();
      });
      togglePvz();

      cdekNote.hidden = false;
      cdekNote.textContent = data.approximate
        ? 'Расчёт предварительный: точный вес посылки менеджер подтвердит при сборке заказа.'
        : `Вес посылки ${(data.weightGrams / 1000).toFixed(1)} кг.`;
    } catch (err) {
      cdekNote.hidden = false;
      cdekNote.textContent = String(err.message || err);
    } finally {
      calcBtn.disabled = false;
      calcBtn.textContent = was;
    }
  });

  // ── конкретный пункт выдачи ──
  // Список приходит от нашего сервера, он же ходит в СДЭК. Ключи в браузер не попадают.
  const pvzField = document.getElementById('pvzField');
  const pvzSelect = document.getElementById('fPvz');
  let pvzLoadedFor = '';

  async function togglePvz() {
    const isPvz = chosenDelivery?.kind === 'pvz';
    pvzField.hidden = !isPvz;
    if (!isPvz) return;

    const city = chosenDelivery.city;
    if (pvzLoadedFor === city) { applyPvz(); return; }

    pvzSelect.innerHTML = '<option>Загружаем пункты…</option>';
    try {
      const res = await fetch('/api/delivery', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pointsFor: city }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.points?.length) throw new Error(data.error || 'Пункты выдачи не найдены');
      pvzSelect.innerHTML = data.points
        .map((p) => `<option value="${p.code}" data-address="${(p.address || '').replace(/"/g, '&quot;')}">${p.address || p.name}${p.workTime ? ' · ' + p.workTime : ''}</option>`)
        .join('');
      pvzLoadedFor = city;
      applyPvz();
    } catch (err) {
      pvzSelect.innerHTML = `<option>${String(err.message || err)}</option>`;
    }
  }

  function applyPvz() {
    const opt = pvzSelect.selectedOptions[0];
    if (!opt || !chosenDelivery) return;
    chosenDelivery.pointCode = opt.value;
    chosenDelivery.pointAddress = opt.dataset.address || opt.textContent;
  }
  pvzSelect?.addEventListener('change', applyPvz);

  payBtn?.addEventListener('click', async () => {
    msg.className = 'form-msg';
    const name = form.name.value.trim();
    const phone = form.phone.value.trim();
    if (!name || !phone) {
      msg.className = 'form-msg err';
      msg.textContent = 'Пожалуйста, укажите имя и телефон — они нужны для доставки.';
      return;
    }
    if (!form.consent.checked) {
      msg.className = 'form-msg err';
      msg.textContent = 'Отметьте согласие с офертой и политикой обработки данных.';
      return;
    }
    const items = payableLines();
    if (!items.length) {
      msg.className = 'form-msg err';
      msg.textContent = 'У выбранных товаров нет цены на сайте — оформите заявку, менеджер посчитает стоимость.';
      return;
    }
    payBtn.disabled = true;
    const original = payBtn.textContent;
    payBtn.textContent = 'Готовим счёт…';
    try {
      const res = await fetch('/api/pay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name, phone,
          email: form.email.value.trim(),
          address: form.address.value.trim(),
          delivery: form.delivery.value,
          comment: form.comment.value.trim(),
          page: location.pathname,
          items,
          ...(chosenDelivery ? { cdek: chosenDelivery } : {}),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.url) throw new Error(data.error || 'bad status ' + res.status);
      if (window.ym) window.ym(Number(99571167), 'reachGoal', 'pay_start');
      location.href = data.url;
    } catch (err) {
      msg.className = 'form-msg err';
      msg.textContent = String(err.message || err);
      payBtn.disabled = false;
      payBtn.textContent = original;
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.className = 'form-msg';
    const name = form.name.value.trim();
    const phone = form.phone.value.trim();
    if (!name || !phone) {
      msg.className = 'form-msg err';
      msg.textContent = 'Пожалуйста, укажите имя и телефон.';
      return;
    }
    if (form.company.value) return; // honeypot
    submit.disabled = true;
    const original = submit.textContent;
    submit.textContent = 'Отправляем…';
    try {
      const data = Object.fromEntries(new FormData(form).entries());
      const res = await fetch('/api/order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error('bad status ' + res.status);
      msg.className = 'form-msg ok';
      msg.textContent = 'Спасибо! Заявка принята. Мы свяжемся с вами в ближайшее время.';
      form.reset();
      summary.hidden = true;
      if (window.ym) window.ym(Number(99571167), 'reachGoal', 'order_submit');
    } catch (err) {
      msg.className = 'form-msg err';
      msg.innerHTML = 'Не удалось отправить онлайн. Напишите нам в <a href="https://wa.me/79960056765" target="_blank" rel="noopener">WhatsApp</a> или <a href="https://t.me/EkoPremi" target="_blank" rel="noopener">Telegram</a> — ответим быстро.';
    } finally {
      submit.disabled = false;
      submit.textContent = original;
    }
  });
</script>
