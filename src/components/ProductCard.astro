---
import Bottle from './Bottle.astro';
const { product } = Astro.props;
const { id, name, art, image, badges = [], short, variants = [] } = product;
const base = variants[0] || { volume: '', price: product.price };
const hasPhoto = image && !image.includes('...');
const fmt = (n) => n.toLocaleString('ru-RU').replace(/ /g, ' ');
---
<article class="pc" data-category={product.category}>
  <a href={`/product/${id}`} class={`top ${art}`} style="text-decoration:none">
    {badges.includes('Органик ГОСТ') && (
      <span class="organic"><svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/></svg>Органик ГОСТ</span>
    )}
    {hasPhoto ? <img src={image} alt={name} loading="lazy" /> : <Bottle art={art} />}
  </a>
  <div class="body">
    <div class="art-no">Артикул {id}</div>
    <h3><a href={`/product/${id}`} style="text-decoration:none;color:inherit">{name}</a></h3>
    <div class="desc">{short}</div>

    {variants.length > 1 && (
      <div class="card-vols">
        {variants.map((v, i) => (
          <button type="button" class={`card-vol-btn${i === 0 ? ' active' : ''}`} data-price={v.price}>{v.volume}</button>
        ))}
      </div>
    )}

    <div class="foot">
      <div class="price"><b class="js-card-price">{fmt(base.price)}&nbsp;₽</b></div>
      <div class="foot-btns">
        <button type="button" class="add-cart js-add-cart" title="В корзину"
          data-id={id} data-name={name} data-image={hasPhoto ? image : ''}
          aria-label="Добавить в корзину">
          <svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4M3 6h18M16 10a4 4 0 0 1-8 0"/></svg>
        </button>
        <button class="add" data-order data-product={name} data-price={base.price}
          data-volume={base.volume} data-variants={JSON.stringify(variants)}>Заказать</button>
      </div>
    </div>
  </div>
</article>
