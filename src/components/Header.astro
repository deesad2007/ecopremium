---
import data from '../data/products.json';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));

// категории каталога для выпадающего подменю
const categories = ['Масла', ...(data.foodCategories || [])];

const links = [
  { href: '/about', label: 'Технология' },
  { href: '/delivery', label: 'Доставка' },
  { href: '/contacts', label: 'Контакты' },
];
---
<header class="site">
  <a href="/" class="brand">Eco<i>Premi</i><small>Поставщик Кремля</small></a>
  <nav class="main" id="mainNav">
    {/* Каталог — раскрывающийся пункт с категориями */}
    <div class="nav-group" id="catGroup">
      <a href="/catalog" class="nav-group-link" aria-current={isActive('/catalog') ? 'page' : undefined}>Каталог</a>
      <button class="nav-group-toggle" id="catToggle" aria-label="Показать категории" aria-expanded="false">
        <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="nav-sub" id="catSub">
        <a href="/catalog">Все товары</a>
        {categories.map((c) => <a href={`/catalog?cat=${encodeURIComponent(c)}`}>{c}</a>)}
      </div>
    </div>

    {links.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <a href="/catalog" class="nav-cta">Каталог</a>
  <button class="cart-toggle" id="cartToggle" aria-label="Корзина">
    <svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4M3 6h18M16 10a4 4 0 0 1-8 0"/></svg>
    <span class="cart-badge" hidden>0</span>
  </button>
  <button class="burger" id="burger" aria-label="Меню" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</header>

<script>
  const burger = document.getElementById('burger');
  const nav = document.getElementById('mainNav');
  burger?.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
    // при закрытии меню сворачиваем и подменю категорий
    if (!open) document.getElementById('catGroup')?.classList.remove('open');
  });

  // раскрытие списка категорий внутри меню
  const catToggle = document.getElementById('catToggle');
  const catGroup = document.getElementById('catGroup');
  catToggle?.addEventListener('click', (e) => {
    e.preventDefault();
    const open = catGroup.classList.toggle('open');
    catToggle.setAttribute('aria-expanded', String(open));
  });

  document.getElementById('cartToggle')?.addEventListener('click', () => {
    window.EcoCart?.open();
  });
</script>
