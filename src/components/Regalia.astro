---
// Секция «Наши сертификаты и регалии» — знаки отличия с привязанными документами.
const items = [
  {
    t: 'Поставщик Московского Кремля',
    d: 'Договор поставки с ФГБУ «Комбинат питания «Кремлевский» Управления делами Президента РФ',
    icon: 'kremlin',
    doc: '/img/docs/dogovor-kremlin.jpg',
    docLabel: 'Смотреть договор',
  },
  {
    t: 'Органический ГОСТ 33980-2016',
    d: 'Сертификат соответствия №065 «Роскачество». Единственный производитель органического масла в России',
    icon: 'leaf',
    doc: '/img/docs/sertifikat-roskachestvo.jpg',
    docLabel: 'Смотреть сертификат',
  },
];
const icons = {
  kremlin: '<path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-7h6v7"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/>',
};
---
<section class="regalia" id="regalia">
  <div class="section-inner">
    <div class="head">
      <div class="lbl ey">Знаки отличия</div>
      <h2>Наши сертификаты <em>и регалии</em></h2>
      <div class="rule"></div>
    </div>
    <div class="regalia-grid">
      {items.map((it) => (
        <div class="regalia-card">
          <div class="medal"><svg viewBox="0 0 24 24" set:html={icons[it.icon]}></svg></div>
          <h4>{it.t}</h4>
          <p>{it.d}</p>
          <a class="regalia-doc" href={it.doc} target="_blank" rel="noopener">
            <img src={it.doc} alt={it.t} loading="lazy" />
            <span>{it.docLabel}</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
