---
// Секция «Наши сертификаты и регалии» — знаки отличия с приложенными документами.
// Общий компонент: подключён на главной и на странице «Технология».
const items = [
  {
    t: 'Поставщик Московского Кремля',
    d: 'Поставки для ФГБУ «Комбинат питания «Кремлевский» Управления делами Президента РФ',
    icon: 'kremlin',
    docs: [
      { src: '/img/docs/dogovor-kremlin.webp', label: 'Договор, стр. 1' },
      { src: '/img/docs/dogovor-kremlin-str2.webp', label: 'Договор, стр. 2' },
    ],
  },
  {
    t: 'Органический ГОСТ',
    tNum: '33980-2016',
    d: 'Сертификат соответствия №065 «Роскачество». Единственный производитель органического масла в России',
    icon: 'leaf',
    docs: [
      { src: '/img/docs/sertifikat-roskachestvo.webp', label: 'Смотреть сертификат' },
    ],
  },
];
const icons = {
  kremlin: '<path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-7h6v7"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/>',
};
---
<section class="regalia" id="regalia">
  <div class="section-inner">
    <div class="head">
      <div class="lbl ey">Знаки отличия</div>
      <h2>Наши сертификаты <em>и регалии</em></h2>
      <div class="rule"></div>
    </div>
    <div class="regalia-grid">
      {items.map((it) => (
        <div class="regalia-card">
          <div class="medal"><svg viewBox="0 0 24 24" set:html={icons[it.icon]}></svg></div>
          <h4>{it.t}{it.tNum && <> <span class="num">{it.tNum}</span></>}</h4>
          <p>{it.d}</p>
          <div class={`regalia-docs${it.docs.length > 1 ? ' multi' : ''}`}>
            {it.docs.map((doc) => (
              <a class="regalia-doc" href={doc.src} target="_blank" rel="noopener">
                <img src={doc.src} alt={`${it.t} — ${doc.label}`} loading="lazy" />
                <span>{doc.label}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
