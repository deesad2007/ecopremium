---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Credentials from '../components/Credentials.astro';
import data from '../data/products.json';

const products = data.products.filter((p) => p.section === 'oils');
---
<Base title="Каталог масел — EcoPremi" description="Каталог сыродавленных органических масел EcoPremi: льняное, тыквенное, конопляное. Ручной отжим, свежий отжим под заказ.">
  <section class="page-hero">
    <div class="ey lbl">Каталог</div>
    <h1>Элитные <em>сыродавленные масла</em></h1>
    <p>Заботьтесь о себе и своих близких. Отжимаем под заказ: органическое сырьё, деревянный пресс, без нагрева и контакта с металлом.</p>
  </section>

  <section>
    <div class="section-inner">
      <div class="cat-tabs">
        <a href="/catalog" class="cat-tab active">Масла</a>
        <a href="/food" class="cat-tab">Продукты питания</a>
      </div>
      <div class="grid" id="catalogGrid">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <Credentials />
</Base>
