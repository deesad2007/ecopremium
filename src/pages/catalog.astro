---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Credentials from '../components/Credentials.astro';
import data from '../data/products.json';

const products = data.products;
// порядок категорий: масла, затем продукты питания
const categories = ['Масла', ...(data.foodCategories || [])];
// категории, в которых пока нет товаров — под них показываем плитку «скоро»
const filled = new Set(products.map((p) => p.category));
const emptyCategories = categories.filter((c) => !filled.has(c));
---
<Base
  title="Каталог — EcoPremi"
  description="Элитные продукты питания из органического сырья: сыродавленные масла, мёд, мука, крупа, жмых. Прямые поставки от производителя, без посредников."
>
  <section class="page-hero">
    <div class="ey lbl">Каталог</div>
    <h1>Элитные продукты питания <em>из органического сырья</em></h1>
    <p>Прямые поставки от производителя, без посредников.</p>
  </section>

  <section>
    <div class="section-inner">
      <div class="filters" id="filters">
        <button class="active" data-filter="Все">Все</button>
        {categories.map((c) => <button data-filter={c}>{c}</button>)}
      </div>

      <div class="grid" id="catalogGrid">
        {products.map((p) => <ProductCard product={p} />)}
      </div>

      {emptyCategories.length > 0 && (
        <div class="soon-grid" id="soonGrid">
          {emptyCategories.map((c) => (
            <div class="soon-card" data-category={c} hidden>
              <div class="soon-ic"><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg></div>
              <h4>{c}</h4>
              <p>Скоро в продаже — уточните наличие и цену у менеджера.</p>
              <button class="btn btn-dark soon-btn" data-order data-product={`Заявка: ${c}`}>Узнать о наличии</button>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <Credentials />
</Base>

<script>
  const filters = document.getElementById('filters');
  const cards = Array.from(document.querySelectorAll('#catalogGrid .pc'));
  const soonCards = Array.from(document.querySelectorAll('.soon-card'));

  function apply(f) {
    // товары нужной категории
    cards.forEach((c) => {
      c.style.display = f === 'Все' || c.dataset.category === f ? '' : 'none';
    });
    // плитка «скоро» — только когда выбрана пустая категория
    soonCards.forEach((c) => {
      c.hidden = !(f !== 'Все' && c.dataset.category === f);
    });
  }

  filters?.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    filters.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    apply(btn.dataset.filter);
  });
</script>
