---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Credentials from '../components/Credentials.astro';
import data from '../data/products.json';

const products = data.products;
// категории: сначала «Масла», затем категории продуктов питания — показываем только непустые
const present = [...new Set(products.map((p) => p.category))];
const order = ['Масла', ...(data.foodCategories || [])];
const categories = order.filter((c) => present.includes(c));
---
<Base
  title="Каталог — EcoPremi"
  description="Элитные продукты питания из органического сырья: сыродавленные масла, мёд, мука, крупа, жмых. Прямые поставки от производителя, без посредников."
>
  <section class="page-hero">
    <div class="ey lbl">Каталог</div>
    <h1>Элитные продукты питания <em>из органического сырья</em></h1>
    <p>Прямые поставки от производителя, без посредников.</p>
  </section>

  <section>
    <div class="section-inner">
      {categories.length > 1 && (
        <div class="filters" id="filters">
          <button class="active" data-filter="Все">Все</button>
          {categories.map((c) => <button data-filter={c}>{c}</button>)}
        </div>
      )}
      <div class="grid" id="catalogGrid">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <Credentials />
</Base>

<script>
  const filters = document.getElementById('filters');
  filters?.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    filters.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    document.querySelectorAll('#catalogGrid .pc').forEach((c) => {
      c.style.display = f === 'Все' || c.dataset.category === f ? '' : 'none';
    });
  });
</script>
