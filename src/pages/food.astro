---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Credentials from '../components/Credentials.astro';
import data from '../data/products.json';

const products = data.products.filter((p) => p.section === 'food');
const categories = data.foodCategories || [];
// какие категории уже наполнены товарами
const filled = new Set(products.map((p) => p.category));
---
<Base
  title="Продукты питания — EcoPremi"
  description="Органические продукты питания EcoPremi: мёд, мука, крупа, жмых. Органическое сырьё, поставки от производителя."
>
  <section class="page-hero">
    <div class="ey lbl">Каталог</div>
    <h1>Элитные <em>продукты питания</em></h1>
    <p>Мёд, мука, крупа и жмых из органического сырья. Прямые поставки от производителя, без посредников.</p>
  </section>

  <section>
    <div class="section-inner">
      <div class="cat-tabs">
        <a href="/catalog" class="cat-tab">Масла</a>
        <a href="/food" class="cat-tab active">Продукты питания</a>
      </div>

      <div class="filters" id="filters">
        <button class="active" data-filter="Все">Все</button>
        {categories.map((c) => <button data-filter={c}>{c}</button>)}
      </div>

      {products.length > 0 ? (
        <div class="grid" id="catalogGrid">
          {products.map((p) => <ProductCard product={p} />)}
        </div>
      ) : (
        <div class="soon-grid">
          {categories.map((c) => (
            <div class="soon-card" data-category={c}>
              <div class="soon-ic"><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg></div>
              <h4>{c}</h4>
              <p>Скоро в продаже — уточняйте наличие у менеджера.</p>
              <button class="btn btn-dark soon-btn" data-order data-product={`Заявка: ${c}`}>Узнать о наличии</button>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <Credentials />
</Base>

<script>
  // фильтр по категориям продуктов питания (работает и для карточек, и для плиток «скоро»)
  const filters = document.getElementById('filters');
  filters?.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    filters.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    document.querySelectorAll('#catalogGrid .pc, .soon-card').forEach((c) => {
      c.style.display = f === 'Все' || c.dataset.category === f ? '' : 'none';
    });
  });
</script>
