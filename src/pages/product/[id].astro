---
import Base from '../../layouts/Base.astro';
import Bottle from '../../components/Bottle.astro';
import ProductCard from '../../components/ProductCard.astro';
import data from '../../data/products.json';

export function getStaticPaths() {
  return data.products.map((p) => ({ params: { id: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const { id, name, description, art, image, badges = [], variants = [] } = product;
const base = variants[0] || { volume: '', price: product.price };
const hasPhoto = image && !image.includes('...');
const related = data.products.filter((p) => p.id !== id).slice(0, 3);
const fmt = (n) => n.toLocaleString('ru-RU').replace(/ /g, ' ');
---
<Base title={`${name} — EcoPremi`} description={product.short}>
  <section style="padding-top:48px">
    <div class="pd">
      <div class={`pd-media ${art}`}>
        {hasPhoto ? <img src={image} alt={name} /> : <Bottle art={art} />}
      </div>
      <div class="pd-info">
        <div class="crumbs"><a href="/">Главная</a> / <a href="/catalog">Каталог</a> / {name}</div>
        <h1>{name}</h1>
        <div class="pd-badges">
          {badges.map((b) => <span>{b}</span>)}
          <span>Артикул {id}</span>
        </div>
        <div class="pd-price">
          <b id="pdPrice">{fmt(base.price)}&nbsp;₽</b>
          <span class="per-vol-lg" id="pdPerVol">за {base.volume}</span>
        </div>
        <p class="desc">{description}</p>
        <div class="pd-vol">
          <span class="vol-label">Объём</span>
          <div class="vol-opts" id="pdVolOpts">
            {variants.map((v, i) => (
              <button type="button" class={`vol-btn${i === 0 ? ' active' : ''}`}
                data-volume={v.volume} data-price={v.price}>{v.volume}</button>
            ))}
          </div>
        </div>
        <div class="pd-actions">
          <button class="btn btn-g" id="pdOrder" data-order data-product={name} data-price={base.price}
            data-volume={base.volume} data-variants={JSON.stringify(variants)}>Заказать</button>
          <button type="button" class="btn btn-dark js-add-cart"
            data-id={id} data-name={name} data-image={hasPhoto ? image : ''}>В корзину</button>
          <a href="/delivery" class="btn btn-dark">Доставка и оплата</a>
        </div>
        <div class="pd-note">
          Свежий отжим под заказ — давим в день отправки. Хранить в холодильнике в тёмной таре.
          Бесплатная доставка от 10&nbsp;000&nbsp;₽. Оплата картой по согласованию после подтверждения заказа.
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:24px">
    <div class="section-inner">
      <div class="head"><div class="lbl ey">Ещё масла</div><h2>Может <em>понравиться</em></h2><div class="rule"></div></div>
      <div class="grid">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
</Base>

<script>
  // переключение объёма -> пересчёт цены
  const opts = document.getElementById('pdVolOpts');
  const priceEl = document.getElementById('pdPrice');
  const perVolEl = document.getElementById('pdPerVol');
  const orderBtn = document.getElementById('pdOrder');
  const nbsp = (s) => s.replace(/ /g, ' ').replace(/ /g, ' ');

  opts?.addEventListener('click', (e) => {
    const btn = e.target.closest('.vol-btn');
    if (!btn) return;
    opts.querySelectorAll('.vol-btn').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    const price = Number(btn.dataset.price);
    const volume = btn.dataset.volume;
    priceEl.innerHTML = nbsp(price.toLocaleString('ru-RU')) + ' ₽';
    perVolEl.textContent = 'за ' + volume;
    orderBtn.dataset.price = String(price);
    orderBtn.dataset.volume = volume;
  });
</script>
