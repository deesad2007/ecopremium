---
import Base from '../../layouts/Base.astro';
import Bottle from '../../components/Bottle.astro';
import FoodPlaceholder from '../../components/FoodPlaceholder.astro';
import ProductCard from '../../components/ProductCard.astro';
import data from '../../data/products.json';
import { sellerFor } from '../../data/site.js';

export function getStaticPaths() {
  return data.products.map((p) => ({ params: { id: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const { id, name, description, art, image, badges = [], variants = [] } = product;
const base = variants[0] || { volume: '', price: product.price };
const hasPhoto = image && !image.includes('...');
const hasPrice = base.price != null && base.price !== '';
const isFood = product.section === 'food';
const vendor = sellerFor(product);
// «может понравиться» — сначала из той же категории, затем из того же раздела
const sameCat = data.products.filter((p) => p.id !== id && p.category === product.category);
const sameSection = data.products.filter((p) => p.id !== id && p.section === product.section && p.category !== product.category);
const related = [...sameCat, ...sameSection].slice(0, 3);
const fmt = (n) => n.toLocaleString('ru-RU').replace(/ /g, ' ');

// ── разбор описания в блоки: абзацы, подзаголовки, списки, состав, служебное ──
const esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
// выделяем слова, написанные КАПСОМ (как на исходном сайте) и «в кавычках»
const emphasize = (s) =>
  esc(s)
    .replace(/(«[^»]+»)/g, '<b>$1</b>')
    .replace(/([А-ЯЁ]{3,}(?:[\s-]+[А-ЯЁ]{2,})*)/g, '<b>$1</b>');

const SPEC_RE = /^(Жирные кислоты|Витамины|Витаминно-минеральный состав|Макро и микроэлементы|Микро-макроэлементы|Аминокислоты|Фитостеролы|В состав входят|В состав ЧТ входят|Состав расторопши)/i;
const META_RE = /^(Срок годности|Хранить|Масло отжимается|Объем|Объём|Допускается|Жмых по желанию)/i;
const BONUS_RE = /^(БОНУСОМ|Бонусом)/i;
const CLAIM_RE = /^(АНАЛОГОВ|Аналогов)/i;
const WARN_RE = /^(Противопоказания|С осторожностью|Не стоит использовать|Детям рекомендуют)/i;

const blocks = [];
for (const rawLine of String(description || product.short || '').split('\n')) {
  const line = rawLine.trim();
  if (!line) continue;

  const last = blocks[blocks.length - 1];

  // строка, внутри которой звёздочками перечислены пункты → список
  // (несколько подряд идущих строк-пунктов собираются в один общий список)
  if ((line.match(/\*/g) || []).length >= 2 || /^[*-]\s?\S/.test(line)) {
    const lead = line.split(/[*]/)[0].trim();
    const items = line.split('*').slice(1).map((s) => s.trim()).filter(Boolean);
    if (lead) blocks.push({ type: 'p', html: emphasize(lead) });
    if (!items.length) continue;
    const tail = blocks[blocks.length - 1];
    if (tail && tail.type === 'ul') tail.items.push(...items.map(emphasize));
    else blocks.push({ type: 'ul', items: items.map(emphasize) });
    continue;
  }
  if (CLAIM_RE.test(line)) { blocks.push({ type: 'claim', html: esc(line) }); continue; }
  if (BONUS_RE.test(line)) { blocks.push({ type: 'bonus', html: emphasize(line) }); continue; }
  // продолжение строки бонуса («Который добавляем в выпечку…») — приклеиваем к ней
  if (last && last.type === 'bonus' && /^(Который|Которые|Его|Их)\s/i.test(line)) {
    last.html += ' ' + emphasize(line);
    continue;
  }
  if (META_RE.test(line)) { blocks.push({ type: 'meta', html: emphasize(line) }); continue; }
  if (WARN_RE.test(line)) { blocks.push({ type: 'warn', html: emphasize(line) }); continue; }
  if (SPEC_RE.test(line)) { blocks.push({ type: 'spec', html: emphasize(line) }); continue; }
  // короткий вопрос или короткая строка без точки в конце → подзаголовок
  if (line.length < 110 && (/\?$/.test(line) || (!/[.!]$/.test(line) && line.length < 70))) {
    blocks.push({ type: 'h', html: esc(line) });
    continue;
  }
  blocks.push({ type: 'p', html: emphasize(line) });
}
// служебные строки (срок годности, объём, бонус) собираем в отдельную рамку внизу
const mainBlocks = blocks.filter((b) => !['meta', 'bonus', 'claim'].includes(b.type));
const footBlocks = blocks.filter((b) => ['meta', 'bonus', 'claim'].includes(b.type));
---
<Base title={`${name} — EcoPremi`} description={product.short}>
  <section style="padding-top:48px">
    <div class="pd">
      <div class={`pd-media ${art}`}>
        {hasPhoto ? <img src={image} alt={name} /> : isFood ? <FoodPlaceholder kind={product.category} /> : <Bottle art={art} />}
      </div>
      <div class="pd-info">
        <div class="crumbs"><a href="/">Главная</a> / <a href="/catalog">Каталог</a> / {name}</div>
        <h1>{name}</h1>
        <div class="pd-badges">
          {badges.map((b) => <span>{b}</span>)}
          <span>Артикул {id}</span>
        </div>
        {hasPrice ? (
          <div class="pd-price">
            <b id="pdPrice">{fmt(base.price)}&nbsp;₽</b>
            <span class="per-vol-lg" id="pdPerVol">за {base.volume}</span>
          </div>
        ) : (
          <div class="pd-price pd-price-ask">
            <b>Цена по&nbsp;запросу</b>
            <span class="per-vol-lg">уточнит менеджер</span>
          </div>
        )}
        <div class="pd-desc">
          {mainBlocks.map((b) => (
            b.type === 'h' ? <h3 class="pd-h" set:html={b.html} />
            : b.type === 'ul' ? <ul class="pd-list">{b.items.map((it) => <li set:html={it} />)}</ul>
            : b.type === 'spec' ? <p class="pd-spec" set:html={b.html} />
            : b.type === 'warn' ? <p class="pd-warn" set:html={b.html} />
            : <p set:html={b.html} />
          ))}
        </div>
        {footBlocks.length > 0 && (
          <div class="pd-facts">
            {footBlocks.map((b) => (
              b.type === 'claim' ? <div class="pd-claim" set:html={b.html} />
              : b.type === 'bonus' ? <div class="pd-bonus" set:html={b.html} />
              : <div class="pd-meta-line" set:html={b.html} />
            ))}
          </div>
        )}
        {hasPrice && variants.length > 0 && (
        <div class="pd-vol">
          <span class="vol-label">{!isFood ? 'Объём' : ['Хлеб', 'Печенье'].includes(product.category) ? 'Вес' : 'Фасовка'}</span>
          <div class="vol-opts" id="pdVolOpts">
            {variants.map((v, i) => (
              <button type="button" class={`vol-btn${i === 0 ? ' active' : ''}`}
                data-volume={v.volume} data-price={v.price}>{v.volume}</button>
            ))}
          </div>
        </div>
        )}
        <div class="pd-actions">
          {hasPrice ? (
            <>
              <button class="btn btn-g" id="pdOrder" data-order data-product={name} data-price={base.price}
                data-volume={base.volume} data-variants={JSON.stringify(variants)}>Заказать</button>
              <button type="button" class="btn btn-dark js-add-cart"
                data-id={id} data-name={name} data-image={hasPhoto ? image : ''}>В корзину</button>
            </>
          ) : (
            <button class="btn btn-g" data-order data-product={name}>Узнать цену</button>
          )}
          <a href="/delivery" class="btn btn-dark">Доставка и оплата</a>
        </div>
        <div class="pd-note">
          {isFood
            ? 'Цену, фасовку и наличие менеджер подтвердит после заявки.'
            : 'Свежий отжим под заказ — давим в день отправки. Хранить в холодильнике в тёмной таре.'}
          Бесплатная доставка от 10&nbsp;000&nbsp;₽.
        </div>
        <div class="pd-vendor">
          Продавец товара: <b>{vendor.shortName}</b>. {vendor.payment}
          <a href="/contacts#rekvizity">Реквизиты</a>
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:24px">
    <div class="section-inner">
      <div class="head"><div class="lbl ey">{isFood ? product.category : 'Ещё масла'}</div><h2>Может <em>понравиться</em></h2><div class="rule"></div></div>
      <div class="grid">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
</Base>

<script>
  // переключение объёма -> пересчёт цены
  const opts = document.getElementById('pdVolOpts');
  const priceEl = document.getElementById('pdPrice');
  const perVolEl = document.getElementById('pdPerVol');
  const orderBtn = document.getElementById('pdOrder');
  const nbsp = (s) => s.replace(/ /g, ' ').replace(/ /g, ' ');

  opts?.addEventListener('click', (e) => {
    const btn = e.target.closest('.vol-btn');
    if (!btn) return;
    opts.querySelectorAll('.vol-btn').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    const price = Number(btn.dataset.price);
    const volume = btn.dataset.volume;
    priceEl.innerHTML = nbsp(price.toLocaleString('ru-RU')) + ' ₽';
    perVolEl.textContent = 'за ' + volume;
    orderBtn.dataset.price = String(price);
    orderBtn.dataset.volume = volume;
  });
</script>
