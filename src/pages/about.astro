---
import Base from '../layouts/Base.astro';
import Regalia from '../components/Regalia.astro';

const faq = [
  { q: 'Чем настоящее живое масло отличается от магазинного?', a: 'Живое масло отжимается на ручном прессе при комнатной температуре, без нагрева и контакта с металлом — так сохраняется природный вкус, аромат и вещества сырья. Магазинное масло часто рафинируют и нагревают.' },
  { q: 'Как вы делаете живое масло?', a: 'Ручной деревянный пресс, комнатная температура, без соприкосновения с металлом. Отжим происходит в день заказа, чтобы масло было максимально свежим.' },
  { q: 'Сколько хранятся сыродавленные масла?', a: 'Это нерафинированный живой продукт с ограниченным сроком хранения. Храните в холодильнике в тёмной таре и употребляйте в течение срока, указанного на этикетке.' },
  { q: 'Не горчат ли масла?', a: 'У некоторых нерафинированных масел возможна лёгкая природная горчинка — это нормально для живого продукта.' },
  { q: 'Из какого сырья делаете масло?', a: 'Используем органическое сырьё, выращенное без ядохимикатов и удобрений, с органическим сертификатом.' },
  { q: 'Что такое жмых и мука?', a: 'Это остаток после отжима. Используется в пищу как источник клетчатки и добавка к блюдам.' },
  { q: 'Почему в масле бывают точки и кусочки?', a: 'Это естественный осадок нерафинированного масла, а не признак порчи.' },
];
---
<Base title="Технология и сертификаты — EcoPremi" description="Сыродавленное против холодного отжима. Органические сертификаты, регалии и ответы на частые вопросы EcoPremi.">
  <section class="page-hero">
    <div class="ey lbl">О нас</div>
    <h1>Масло, отжатое <em>как сотни лет назад</em></h1>
    <p>Ручной деревянный пресс, комнатная температура, органическое сырьё. Подаём дорого и честно — без медицинских обещаний.</p>
  </section>

  {/* технология vs */}
  <section class="craft">
    <div class="section-inner">
      <div class="head light">
        <div class="lbl ey" style="color:var(--kz-violet-lt)">Технология</div>
        <h2>В чём отличие сыродавленного масла <em>от масла холодного отжима</em></h2>
        <div class="rule"></div>
      </div>
      <div class="vs">
        <div class="vbox bad">
          <div class="tag">Холодный отжим</div>
          <p>Семена пропускают через металлический шнековый пресс, где они нагреваются до t 120° — при этом микроэлементы и витамины уничтожаются, а в соприкосновении с металлом ещё и окисляются. И чтобы масло долго хранилось, в него добавляют запрещённые консерванты.</p>
        </div>
        <div class="vbox good">
          <div class="tag">Сыродавленное масло</div>
          <p>Давится старинным способом на обычном ручном прессе, при комнатной t и никакого соприкосновения с металлом. Полностью сохраняются все биологически активные вещества.</p>
        </div>
      </div>
      <div class="note">Приезжайте на маслодельню и увидите весь процесс своими глазами — нам нечего скрывать.</div>
    </div>
  </section>

  {/* ── ЖИВОЕ ОРГАНИЧЕСКОЕ МАСЛО ── */}
  <section>
    <div class="section-inner">
      <div class="head">
        <div class="lbl ey">Как мы работаем</div>
        <h2 class="h2-green">Живое органическое масло</h2>
        <div class="rule"></div>
      </div>
      <div class="tech-prose">
        <p><b>Живое органическое масло</b> получено самым обычным прессованием в бочках на маслопрессах, как и сотни лет назад.</p>
        <ul>
          <li>Преимуществом высокой степени качества масла, конечно же, является сырьё, выращенное по системе органического земледелия, подтверждённое Органическим сертификатом российского или зарубежного происхождения.</li>
          <li>Мы не давим впрок — наши сыродавленные масла готовятся в день отправки.</li>
          <li>Вы можете приехать к нам на маслодельню и увидеть процесс своими глазами.</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ── ЭЛИТНОЕ МАСЛО ── */}
  <section style="background:var(--bone)">
    <div class="section-inner">
      <div class="head">
        <div class="lbl ey">Почему это важно</div>
        <h2 class="h2-green">Элитное масло</h2>
        <div class="rule"></div>
      </div>
      <div class="tech-prose">
        <p>В Евросоюзе продукты из органического сырья официально признаны лечебными и включены в национальные программы по оздоровлению населения.</p>
        <p>Теперь и в России у нас появилась возможность производить продукт высочайшего качества, а у покупателя — абсолютная уверенность, что это действительно чистый и полезный продукт.</p>
        <p><b>Органический сертификат №065 «Роскачество», Госреестр Минсельхоза РФ.</b></p>
        <p class="tech-claim">Аналогов в России нет!</p>
      </div>
    </div>
  </section>

  <Regalia />

  {/* ── КУДА ПОСТАВЛЯЕМ ── */}
  <section style="background:var(--bone);padding-top:0">
    <div class="section-inner">
      <div class="deliver-kremlin">
        <h3>Куда мы поставляем</h3>
        <p>По договору с ФГБУ «Комбинат питания «Кремлевский» Управления делами Президента РФ поставка осуществляется по адресам:</p>
        <ul>
          <li>г. Москва, Кремль, Государственный Кремлёвский Дворец, подъезд 10</li>
          <li>г. Москва, Копьевский переулок, д. 3</li>
          <li>г. Москва, Ипатьевский переулок, д. 9/1, стр. 1</li>
          <li>г. Москва, Краснопресненская набережная, д. 2, стр. 1</li>
          <li>г. Москва, улица Охотный Ряд, д. 1</li>
          <li>г. Москва, улица Большая Дмитровка, д. 26</li>
          <li>г. Москва, улица Зубовская, д. 2</li>
        </ul>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section>
    <div class="section-inner">
      <div class="head">
        <div class="lbl ey">Вопросы и ответы</div>
        <h2>Частые <em>вопросы</em></h2>
        <div class="rule"></div>
      </div>
      <div class="faq">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <div class="ans">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="section-inner">
      <h2>Попробуйте <em>живое масло</em></h2>
      <p>Отжимаем под заказ. Доставка по всей России.</p>
      <a href="/catalog" class="btn btn-g">Перейти в каталог</a>
    </div>
  </section>
</Base>
