---
import Base from '../layouts/Base.astro';
import Regalia from '../components/Regalia.astro';
import ProductCard from '../components/ProductCard.astro';
import data from '../data/products.json';

const products = data.products;
const usp = [
  { t: 'Поставщик Московского Кремля', d: 'Контроль качества в лаборатории Управделами Президента РФ.' },
  { t: 'Единственный производитель органического масла в России', d: 'Органический сертификат ГОСТ 33980-2016, №065 «Роскачество», Госреестр Минсельхоза.' },
  { t: 'Цены ниже конкурентов', d: 'Прямые поставки от производителя, без посредников.' },
];
---
<Base>
  {/* ── HERO ── */}
  <div class="hero">
    <div class="hero-grain"></div>
    <div class="hero-inner hero-2col">
      <div class="hero-text">
        <h1>Элитные сыродавленные масла <em>и продукты питания</em></h1>
        <div class="acts">
          <a href="/catalog" class="btn btn-g">Выбрать масло</a>
        </div>
        <div class="rule"></div>
        <div class="hero-accent">
          <p class="acc-gold">Высокую степень качества и безупречную безопасность гарантирует проверка в&nbsp;лаборатории Управ. Делами Президента РФ. <span class="w">(Являемся Поставщиком Московского Кремля)</span></p>
          <p class="acc-gold">Единственные в России сертифицированы по органическому ГОСТ&nbsp;33980-2016 <span class="w">— земля и зерно не обрабатываются ядохимикатами и химическими удобрениями.</span></p>
          <p><b>Не используем:</b> ГМО-сырьё, Е-добавки, консерванты, антибиотики, ароматизаторы, красители, синтетические добавки, пальмовое масло.</p>
        </div>
      </div>
      <aside class="hero-seals">
        <span class="seal-card seal-kremlin">
          <span class="seal-cap">Поставщик</span>
          <img src="/img/badge-kremlin-emblem.webp" alt="Поставщик Московского Кремля" loading="eager" />
          <span class="seal-cap">Московского Кремля</span>
        </span>
        <span class="seal-card seal-organic">
          <img src="/img/badge-organic.webp" alt="Органический сертификат ГОСТ 33980-2016" loading="eager" />
        </span>
      </aside>
    </div>
  </div>

  {/* ── TOP PRODUCTS ── */}
  <section id="catalog">
    <div class="section-inner">
      <div class="head">
        <div class="lbl ey">Каталог</div>
        <h2>Масла, отжатые <em>сегодня для вас</em></h2>
        <div class="rule"></div>
      </div>
      <div class="grid">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
      <div style="text-align:center;margin-top:48px">
        <a href="/catalog" class="btn btn-dark">Весь каталог</a>
      </div>
    </div>
  </section>

  {/* ── TECHNOLOGY ── */}
  <section class="craft" id="craft">
    <div class="section-inner">
      <div class="head light">
        <div class="lbl ey" style="color:var(--gold)">Технология</div>
        <h2>В чём отличие сыродавленного масла <em>от масла холодного отжима</em></h2>
        <div class="rule"></div>
      </div>
      <div class="vs">
        <div class="vbox bad">
          <div class="tag">Холодный отжим</div>
          <p>Семена пропускают через металлический шнековый пресс, где они нагреваются до t 120° — при этом микроэлементы и витамины уничтожаются, а в соприкосновении с металлом ещё и окисляются. И чтобы масло долго хранилось, в него добавляют запрещённые консерванты.</p>
        </div>
        <div class="vbox good">
          <div class="tag">Сыродавленное масло</div>
          <p>Давится старинным способом на обычном ручном прессе, при комнатной t и никакого соприкосновения с металлом. Полностью сохраняются все биологически активные вещества.</p>
        </div>
      </div>
      <div class="note">Приезжайте на маслодельню и увидите весь процесс своими глазами — нам нечего скрывать.</div>
    </div>
  </section>

  {/* ── USP LIST ── */}
  <section>
    <div class="section-inner">
      <div class="head">
        <div class="lbl ey">Почему мы</div>
        <h2>Чем мы <em>отличаемся</em></h2>
        <div class="rule"></div>
      </div>
      <ul class="usp">
        {usp.map((u) => (
          <li>
            <span class="ic"><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg></span>
            <div><b>{u.t}</b><p>{u.d}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ── REGALIA ── */}
  <Regalia />

  {/* ── CLOSING CTA ── */}
  <section class="closing">
    <div class="section-inner">
      <h2>Закажите масло, <em>отжатое именно для Вас</em></h2>
      <p>Формируем заказы сегодня — на завтра. Бесплатная доставка от 10&nbsp;000&nbsp;₽ по всей России.</p>
      <button class="btn btn-g" data-order>Оформить заявку</button>
    </div>
  </section>
</Base>
