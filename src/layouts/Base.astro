---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickContacts from '../components/QuickContacts.astro';
import OrderModal from '../components/OrderModal.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Analytics from '../components/Analytics.astro';

const {
  title = 'EcoPremi — Живые сыродавленные масла | Поставщик Кремля',
  description = 'Сыродавленные органические масла ручного отжима. Поставщик Московского Кремля, органический сертификат ГОСТ 33980-2016. Свежий отжим под заказ, доставка по России.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://ekopremium.ru').href;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/* Явно говорим браузеру, что сайт только светлый — иначе Samsung Internet / Android Chrome
      с «автотёмной темой» перекрашивают светлые элементы сами, ломая продуманную палитру.
      `only light` — сильнее обычного `light`: запрещает авто-затемнение, а не просто сообщает тему. */}
  <meta name="color-scheme" content="only light" />
  <meta name="supported-color-schemes" content="light" />
  <meta name="theme-color" content="#17131d" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="ru_RU" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  {/* шрифты: preconnect + асинхронная загрузка стилей, чтобы не блокировать рендер страницы */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600;1,700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@300;400;500;600;700&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600;1,700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@300;400;500;600;700&display=swap"
    />
  </noscript>

  <Analytics />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <QuickContacts />

  {/* липкая кнопка заявки — только на телефоне, для конверсии */}
  <div class="mobile-cta">
    <a href="tel:+79960056765" class="mcta-call" aria-label="Позвонить">
      <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    </a>
    <button class="btn btn-g mcta-order" data-order>Оставить заявку</button>
  </div>

  <OrderModal />
  <CartDrawer />
</body>
</html>
