# ─────────────────────────────────────────────────────────────
# EcoPremium — переменные окружения сайта
# Скопируйте в .env для локальной разработки
# и пропишите эти же ключи в панели Timeweb → приложение → Переменные окружения.
# В коде НИКАКИЕ секреты не хранятся. Все значения вводит клиент / вы с его разрешения.
# Любая интеграция необязательна: если ключи не заданы — этот канал просто пропускается,
# заявка всё равно уходит в остальные каналы и пользователь видит успех.
# ─────────────────────────────────────────────────────────────

# ── amoCRM ──
# Поддомен аккаунта без https:// (например: ekopremium)
AMOCRM_SUBDOMAIN=
# Долгоживущий токен доступа (Long-lived token) из приватной интеграции amoCRM
AMOCRM_ACCESS_TOKEN=
# ID воронки и статуса, куда класть новые заявки (необязательно — без них сделка падёт в дефолтную воронку)
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
# ID кастомных полей контакта (field_id) для телефона и email. Узнать через GET /api/v4/contacts/custom_fields
AMOCRM_PHONE_FIELD_ID=
AMOCRM_EMAIL_FIELD_ID=

# ── Telegram ──
# Токен бота @Ecopremi_bot от @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID, куда слать заявки (узнать через @userinfobot или getUpdates). Можно несколько через запятую.
TELEGRAM_CHAT_ID=

# ── Email (SMTP) ──
# SMTP клиента. Для mail.ru: host smtp.mail.ru, port 465, secure=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# От кого и кому отправлять дубль заявки
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=maslo8540@mail.ru

# ── Робокасса (оплата картой на сайте) ──
# Продавец — ООО «ПОКРОВ». Значения берутся в кабинете Робокассы,
# раздел «Мои магазины» → «Технические настройки».
# Идентификатор магазина
ROBOKASSA_LOGIN=
# Пароль №1 — им подписывается запрос на оплату
ROBOKASSA_PASS1=
# Пароль №2 — им проверяется уведомление об оплате на ResultURL
ROBOKASSA_PASS2=
# Система налогообложения ООО для чека: osn, usn_income, usn_income_outcome, esn, patent
ROBOKASSA_SNO=
# Ставка НДС в позициях чека: none, vat0, vat5, vat7, vat10, vat20, vat22,
# vat105, vat107, vat110, vat120, vat122. Для продуктов питания по льготному
# перечню это vat10, основная ставка с 2026 года — vat22.
ROBOKASSA_VAT=
# Пока идёт тестирование — поставить 1, деньги списываться не будут
ROBOKASSA_IS_TEST=1
