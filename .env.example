# ─────────────────────────────────────────────────────────────
# EcoPremium — переменные окружения сайта
# Скопируйте в .env для локальной разработки
# и пропишите эти же ключи в панели Timeweb → приложение → Переменные окружения.
# В коде НИКАКИЕ секреты не хранятся. Все значения вводит клиент / вы с его разрешения.
# Любая интеграция необязательна: если ключи не заданы — этот канал просто пропускается,
# заявка всё равно уходит в остальные каналы и пользователь видит успех.
# ─────────────────────────────────────────────────────────────

# ── amoCRM ──
# Поддомен аккаунта без https:// (например: ekopremium)
AMOCRM_SUBDOMAIN=
# Долгоживущий токен доступа (Long-lived token) из приватной интеграции amoCRM
AMOCRM_ACCESS_TOKEN=
# ID воронки и статуса, куда класть новые заявки (необязательно — без них сделка падёт в дефолтную воронку)
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
# ID кастомных полей контакта (field_id) для телефона и email. Узнать через GET /api/v4/contacts/custom_fields
AMOCRM_PHONE_FIELD_ID=
AMOCRM_EMAIL_FIELD_ID=

# ── Telegram ──
# Токен бота @Ecopremi_bot от @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID, куда слать заявки (узнать через @userinfobot или getUpdates). Можно несколько через запятую.
TELEGRAM_CHAT_ID=

# ── Email (SMTP) ──
# SMTP клиента. Для mail.ru: host smtp.mail.ru, port 465, secure=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# От кого и кому отправлять дубль заявки
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=maslo8540@mail.ru

# ── Робокасса (оплата картой на сайте) ──
# Продавец — ООО «ПОКРОВ». Значения берутся в кабинете Робокассы,
# раздел «Мои магазины» → «Технические настройки».
# Идентификатор магазина
ROBOKASSA_LOGIN=
# Пароль №1 — им подписывается запрос на оплату
ROBOKASSA_PASS1=
# Пароль №2 — им проверяется уведомление об оплате на ResultURL
ROBOKASSA_PASS2=
# Система налогообложения для чека: osn, usn_income, usn_income_outcome, esn, patent.
# Можно оставить пустой: тогда применится та, что указана в кабинете Робокассы.
ROBOKASSA_SNO=
# Ставка НДС в позициях чека: none, vat0, vat5, vat7, vat10, vat20, vat22,
# vat105, vat107, vat110, vat120, vat122. Для продуктов питания по льготному
# перечню это vat10, основная ставка с 2026 года — vat22.
ROBOKASSA_VAT=
# Ставка НДС для доставки. Решение владельца от 20.09.2026: ставить 10%,
# как и на продукты. Доставка — услуга, и льготная ставка на неё
# распространяется не всегда, поэтому значение стоит перепроверить
# у бухгалтера перед выключением тестового режима.
ROBOKASSA_VAT_DELIVERY=vat10
# Пока идёт тестирование — поставить 1, деньги списываться не будут
ROBOKASSA_IS_TEST=1

# ── СДЭК (расчёт доставки) ──
# Ключи берутся в кабинете lk.cdek.ru → «Интеграция» → «Ключи API».
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# 1 — работать на тестовом контуре api.edu.cdek.ru, деньги и заказы ненастоящие
CDEK_TEST=1
# Индекс склада отправителя (Дивеево)
CDEK_FROM_POSTAL=607320
# Код города отправителя в справочнике СДЭК. Если задан, используется вместо индекса.
# 1002 — Арзамас, ближайший к Дивеево город с отделениями СДЭК (их там три).
# Это даёт тарифы «склад-склад»: 380 рублей до Москвы против 1560 при заборе
# курьером из Дивеево. ВАЖНО: настройка обещает покупателю цену отправки
# из Арзамаса, значит посылки туда действительно надо привозить.
CDEK_FROM_CODE=1002
# Как посылки попадают в СДЭК: warehouse — сдаём сами в отделении (дешевле),
# door — курьер приезжает за ними к нам. Выезд курьера в Дивеево стоит около
# тысячи рублей фиксированно на каждую посылку.
CDEK_SHIP_FROM=warehouse
# Габариты коробки в МИЛЛИМЕТРАХ: клиент подтвердил одну на весь ассортимент.
# В запрос к СДЭКу они переводятся в сантиметры автоматически, менять не нужно.
CDEK_BOX_L=233
CDEK_BOX_W=193
CDEK_BOX_H=98
# Вес одной единицы товара в граммах, пока веса не проставлены в каталоге.
# Пока он используется, расчёт помечается приблизительным.
CDEK_DEFAULT_WEIGHT_G=1000
